# Copy to .env.local. Never share the secret key or commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...) or legacy service_role key; SERVER ONLY.
SUPABASE_SECRET_KEY=
# Used by npm run setup:admin only. Remove after creating the first administrator.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional enquiry email delivery. Empty settings still save enquiries in Supabase.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
RATE_LIMIT_PER_HOUR=10
# Production requires a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
