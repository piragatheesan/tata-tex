# Copy to .env.local and fill in. Never commit .env.local.

# --- Admin login ---
# Long random string used to sign login cookies (required in production). Example: openssl rand -hex 32
SESSION_SECRET=
# The first administrator is created automatically on the first start if no users exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-password
# Login cookies are marked "secure" in production (HTTPS only). Set to false ONLY if you run over plain http on a private network.
COOKIE_SECURE=true

# --- Storage ---
# Folder for the database file and uploaded product images (default: ./data). Back this folder up.
DATA_DIR=./data

# --- Email (SMTP). Leave SMTP_HOST empty for dry-run mode (emails only printed in the server log). ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-sender@gmail.com
MAIL_TO=where-enquiries-should-arrive@example.com

# Optional: lets another system read enquiries at GET /api/enquiries (header x-api-key). Leave empty to disable.
ADMIN_API_KEY=
RATE_LIMIT_PER_HOUR=10
